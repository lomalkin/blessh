#!/bin/sh
set -e

KEY=/etc/ble-term/ssh_host_ed25519_key

# BlueZ before 5.67 enables EATT by default. bluetoothd then opens an EATT
# channel to the phone, the phone refuses it without encryption, and
# bluetoothd asks the phone to pair; whatever the user answers, the
# connection usually drops. Later BlueZ versions default to Channels = 1.
# The package does not edit bluez's configuration; it only explains.
eatt_hint() {
    v=$(dpkg-query -W -f '${Version}' bluez 2>/dev/null) || return 0
    dpkg --compare-versions "$v" lt 5.67 || return 0
    if grep -Eq '^[[:space:]]*Channels[[:space:]]*=[[:space:]]*1[[:space:]]*$' /etc/bluetooth/main.conf 2>/dev/null; then
        return 0
    fi
    echo "ble-term: BlueZ $v enables EATT, which makes phones show a pairing request and drop"
    echo "  the connection. Disable it (the default since BlueZ 5.67) by adding"
    echo "      Channels = 1"
    echo "  to the [GATT] section of /etc/bluetooth/main.conf, then run"
    echo "      sudo systemctl restart bluetooth"
}

# Explains why Bluetooth is unusable, if it is. The package does not change
# the rfkill state itself: a block is often deliberate.
bluetooth_hint() {
    found=
    for d in /sys/class/bluetooth/hci*; do
        case $d in *:*) continue ;; esac
        [ -e "$d" ] || continue
        found=1
        hci=${d##*/}
        for r in "$d"/rfkill*; do
            [ -r "$r/soft" ] || continue
            if [ "$(cat "$r/hard")" = 1 ]; then
                echo "ble-term: Bluetooth adapter $hci is blocked by a hardware switch or the firmware (rfkill hard block)."
            elif [ "$(cat "$r/soft")" = 1 ]; then
                echo "ble-term: Bluetooth adapter $hci is off (blocked by rfkill). Switch it on with:"
                echo "  sudo rfkill unblock bluetooth"
            fi
        done
    done
    if [ -z "$found" ]; then
        echo "ble-term: no Bluetooth adapter found; ble-term-daemon will wait for one."
    fi
}

if [ "$1" = configure ]; then
    systemd-sysusers ble-term.conf
    systemd-tmpfiles --create ble-term.conf || true
    if [ ! -f "$KEY" ]; then
        ssh-keygen -q -t ed25519 -N '' -C "ble-term@$(hostname)" -f "$KEY"
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable ble-term-session.socket ble-term.service >/dev/null
        systemctl restart ble-term-session.socket
        if systemctl -q is-active bluetooth.service; then
            systemctl restart ble-term.service
        fi
    fi
    echo "ble-term: BLE SSH host key fingerprint:"
    ssh-keygen -l -f "$KEY.pub" | sed 's/^/  /'
    bluetooth_hint
    eatt_hint
fi

exit 0
