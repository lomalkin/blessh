# sshd configuration for SSH sessions over Bluetooth LE.
#
# Each BLE client gets its own `sshd -i -f /etc/ble-term/sshd_config` from
# ble-term-session@.service. BLE is one more way into the system SSH
# server: all settings, including the host keys, come from
# /etc/ssh/sshd_config, included below. ssh.service does not have to be
# running.
#
# sshd uses the first value it reads for most keywords, so settings placed
# above the Include apply to BLE sessions only and win over the system
# configuration, for example:
#AllowGroups ble-term
# sshd sees no source address for BLE clients ("UNKNOWN"), so `Match
# Address` blocks in the system configuration do not apply to them.
# Show the settings BLE sessions get:
#   sudo sshd -T -f /etc/ble-term/sshd_config

Include /etc/ssh/sshd_config
