[Unit]
Description=SSH over Bluetooth LE (ble-term GATT server)
Documentation=file:///usr/share/doc/ble-term/README.md
After=bluetooth.service ble-term-session.socket
Requires=ble-term-session.socket
# Registrations live on the D-Bus connection to bluetoothd, so restart with it.
PartOf=bluetooth.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/ble-term
# As root ("+"): keeps BlueZ < 5.67 from asking phones to pair.
ExecStartPre=+/usr/lib/ble-term/eatt-off
ExecStart=/usr/sbin/ble-term-daemon $BLE_TERM_ARGS
User=_bleterm
Group=_bleterm
SupplementaryGroups=bluetooth
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
# bluetooth.target comes up when the adapter appears; multi-user.target
# covers boots where it does not, e.g. after a soft-reboot, when the adapter
# is already there. The daemon's first call to org.bluez then starts
# bluetoothd through D-Bus activation, which only works while
# bluetooth.service is enabled.
WantedBy=bluetooth.target multi-user.target
