<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchDaemon installed by `blessh server enable`: like Apple's ssh.plist
     (Remote Login), but listening on 127.0.0.1 only. launchd starts the
     system's sshd for every connection, which the BLE server opens for
     each session; sshd reads /etc/blessh/sshd_config, which includes the
     system configuration. Nothing of blessh runs as root.
     docs/macos-server.md explains the choice. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.blessh.sshd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/sbin/sshd</string>
		<string>-i</string>
		<string>-f</string>
		<string>/etc/blessh/sshd_config</string>
	</array>
	<key>Sockets</key>
	<dict>
		<key>Listeners</key>
		<dict>
			<key>SockNodeName</key>
			<string>127.0.0.1</string>
			<key>SockServiceName</key>
			<string>@PORT@</string>
			<key>SockFamily</key>
			<string>IPv4</string>
		</dict>
	</dict>
	<key>inetdCompatibility</key>
	<dict>
		<key>Wait</key>
		<false/>
	</dict>
	<key>StandardErrorPath</key>
	<string>/dev/null</string>
</dict>
</plist>
