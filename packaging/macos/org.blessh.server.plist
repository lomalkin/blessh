<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent: the BLE server runs in the user's session, because macOS
     grants Bluetooth to logged-in users only. Sessions go to the launchd
     socket of org.blessh.session, where sshd runs as root. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.blessh.server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/blessh/blessh-server</string>
		<string>--session-socket</string>
		<string>/var/run/blessh-session.sock</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>/tmp/blessh-server.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/blessh-server.log</string>
</dict>
</plist>
