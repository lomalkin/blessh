<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchDaemon: one sshd -i per connection to the session socket, like
     Apple's own ssh.plist. blessh-session logs the session's preamble
     (id, device, transport), then execs sshd with the system
     configuration included from /etc/blessh/sshd_config. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.blessh.session</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/blessh/blessh-session</string>
		<string>--</string>
		<string>/usr/sbin/sshd</string>
		<string>-i</string>
		<string>-f</string>
		<string>/etc/blessh/sshd_config</string>
	</array>
	<key>Sockets</key>
	<dict>
		<key>Listeners</key>
		<dict>
			<key>SockFamily</key>
			<string>Unix</string>
			<key>SockPathName</key>
			<string>/var/run/blessh-session.sock</string>
			<key>SockPathMode</key>
			<integer>438</integer>
		</dict>
	</dict>
	<key>inetdCompatibility</key>
	<dict>
		<key>Wait</key>
		<false/>
	</dict>
	<key>StandardErrorPath</key>
	<string>/var/log/blessh-session.log</string>
</dict>
</plist>
