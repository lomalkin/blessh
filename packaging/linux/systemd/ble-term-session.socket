[Unit]
Description=ble-term session socket (one sshd -i per BLE client)
Documentation=file:///usr/share/doc/ble-term/README.md

[Socket]
ListenStream=/run/ble-term/session.sock
Accept=yes
SocketUser=_bleterm
SocketGroup=_bleterm
SocketMode=0600
DirectoryMode=0755
MaxConnections=4

[Install]
WantedBy=sockets.target
