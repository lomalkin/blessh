[Unit]
Description=blessh session socket (one sshd -i per BLE client)
Documentation=file:///usr/share/doc/blessh-server/README.md

[Socket]
ListenStream=/run/blessh/session.sock
Accept=yes
SocketUser=_blessh
SocketGroup=_blessh
SocketMode=0600
DirectoryMode=0755
MaxConnections=4

[Install]
WantedBy=sockets.target
