[Unit]
Description=blessh SSH session
Documentation=file:///usr/share/doc/blessh/README.md
# Uses the system SSH server's configuration and host keys
# (/etc/blessh/sshd_config includes /etc/ssh/sshd_config), but not
# ssh.service: the network SSH server may stay disabled.

[Service]
# `blessh server session` logs the session id and BLE device sent by the daemon,
# then execs sshd; both end up in the journal of this unit.
ExecStart=-/usr/bin/blessh server session -- /usr/sbin/sshd -i -f /etc/blessh/sshd_config
StandardInput=socket
StandardOutput=socket
StandardError=journal
# sshd's privilege separation directory, also while ssh.service is off. It is
# shared with ssh.service and stays when a session ends.
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
