#!/bin/sh
set -e

# The server stays off until `blessh server enable`, which also prints its
# checks (`blessh server status`). A first installation prints how to
# connect and how to serve; an upgrade restarts a server that is on.

help() {
    echo "blessh $(dpkg-query -W -f '${Version}' blessh): SSH over Bluetooth LE"
    echo "  Connect   blessh                   pick a server in range"
    echo "            blessh user@server       by its name"
    echo "  Serve     blessh server enable     the server is off until then"
    if [ ! -x /usr/sbin/sshd ]; then
        echo "            (it needs OpenSSH's server first: sudo apt install openssh-server)"
    fi
    echo "  Docs      /usr/share/doc/blessh/README.md"
}

if [ "$1" = configure ]; then
    systemd-sysusers blessh.conf
    if [ -d /run/systemd/system ]; then
        # The D-Bus policy names _blessh; the bus ignores it if it read the
        # file before systemd-sysusers created the user.
        systemctl reload dbus.service 2>/dev/null || true
        systemctl daemon-reload
        if [ -n "$2" ] && systemctl -q is-enabled blessh-server.service 2>/dev/null; then
            systemctl restart blessh-session.socket
            # Also when bluetoothd is not running: the daemon starts it
            # through D-Bus activation if bluetooth.service is enabled.
            if systemctl -q is-active bluetooth.service || systemctl -q is-enabled bluetooth.service; then
                systemctl restart blessh-server.service
            fi
            echo "blessh $(dpkg-query -W -f '${Version}' blessh): the server was restarted"
            /usr/bin/blessh server status || true
        fi
    fi
    if [ -z "$2" ]; then
        help
    fi
fi

exit 0
