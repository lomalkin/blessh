#!/bin/sh
set -e

# Undo what /usr/lib/blessh/eatt-off did on BlueZ before 5.67.
if [ "$1" = remove ] || [ "$1" = purge ]; then
    if [ -e /run/blessh-ecred-off ]; then
        echo Y > /sys/module/bluetooth/parameters/enable_ecred 2>/dev/null || true
        rm -f /run/blessh-ecred-off
    fi
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi

exit 0
